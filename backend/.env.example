# Flask
FLASK_SECRET_KEY=                  # random signing secret, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
FLASK_ENV=development              # "development" or "production"
CORS_ALLOWED_ORIGINS=http://localhost:3000  # comma-separated origins allowed 
LOG_LEVEL=INFO                     # root logger level

# Qdrant (vector DB)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_passages
EMBEDDING_SERVICE_URL=http://embedding:80   # compose service name; TEI serving bge-m3
RERANKER_SERVICE_URL=http://reranker:80     # compose service name; TEI serving bge-reranker-v2-m3
RERANK_TOP_K=5

# Ingestion
DATASET_CACHE_DIR=/app/.cache/datasets

# Sarvam AI (STT)
SARVAM_API_KEY=                 
SARVAM_STT_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3

# Ollama Cloud (LLM)
OLLAMA_API_KEY= 
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud

# Guardrails
OFF_TOPIC_DISTANCE_THRESHOLD=0.5 
MIN_QUERY_LENGTH_CHARS=3   
CONFIDENCE_FLOOR_THRESHOLD=0.5  

# Reranking
RERANK_ENABLED=false 