diff --git a/frontend/Dockerfile b/frontend/Dockerfile
new file mode 100644
index 0000000..cf76a7a
--- /dev/null
+++ b/frontend/Dockerfile
@@ -0,0 +1,37 @@
+# syntax=docker/dockerfile:1
+
+# ---- deps (bun is fastest for install; lockfile is bun.lock) ----
+FROM oven/bun:1.3.14 AS deps
+WORKDIR /app
+COPY package.json bun.lock ./
+RUN bun install --frozen-lockfile
+
+# ---- builder (node runs `next build` -- avoids a Bun SIGILL crash on
+#      some CPUs that happens during Bun's process teardown after build) ----
+FROM node:22-slim AS builder
+WORKDIR /app
+COPY --from=deps /app/node_modules ./node_modules
+COPY . .
+# NEXT_PUBLIC_API_BASE_URL must be present at build time so it is inlined
+# into the client bundle. Set it in Railway's service-level env vars.
+ARG NEXT_PUBLIC_API_BASE_URL
+ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
+ENV NEXT_TELEMETRY_DISABLED=1
+RUN node node_modules/.bin/next build
+
+# ---- runtime (standalone server, no node_modules needed) ----
+FROM node:22-slim AS runtime
+WORKDIR /app
+ENV NODE_ENV=production
+ENV NEXT_TELEMETRY_DISABLED=1
+ENV PORT=3000
+ENV HOSTNAME=0.0.0.0
+
+# next standalone build copies only what the server needs into .next/standalone.
+# (No top-level public/ dir in this project; if one is added, also copy it here.)
+COPY --from=builder /app/.next/standalone ./
+COPY --from=builder /app/.next/static ./.next/static
+
+EXPOSE 3000
+# `next start` standalone server listens on $PORT (Railway injects PORT).
+CMD ["node", "server.js"]
